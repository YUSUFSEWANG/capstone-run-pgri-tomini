# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Port server
PORT=3000

# Kunci rahasia untuk session cookie. WAJIB diganti sebelum dipakai publik.
# Buat acak: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-panjang

# production | development
NODE_ENV=development

# Akun admin pertama yang dibuat oleh `npm run db:seed`.
# Biarkan password KOSONG — seed akan membuatkan yang acak dan menampilkannya
# sekali di terminal. Jangan pernah menulis password sungguhan di berkas ini.
SEED_ADMIN_USERNAME=panitia
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Panitia Fun Run

# Set true jika dijalankan di belakang reverse proxy (nginx, Railway, Render)
TRUST_PROXY=false
